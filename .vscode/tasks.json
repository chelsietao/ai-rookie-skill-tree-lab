{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Rookie Lab: reproduce CI",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python scripts/reproduce_all.py --profile ci",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Rookie Lab: tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m pytest",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Rookie Lab: API",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python -m uvicorn rookie_lab.serving.api:app --reload",
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}

